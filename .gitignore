    "Какао на молоке (без сахара)": (67, 3.0, 2.5, 8.0, 40, "Напитки"),
}

FOOD_LIST = sorted(FOOD_DB.keys())

# ==================== СОСТОЯНИЕ ====================
if "meals" not in st.session_state:
    st.session_state.meals = []
if "goals" not in st.session_state:
    st.session_state.goals = {
        "calories": 1800,
        "protein": 120,
        "fat": 60,
        "carbs": 180,
        "fiber": 25,
    }

# ==================== БОКОВАЯ ПАНЕЛЬ ====================
with st.sidebar:
    st.header("⚙️ Настройки")

    st.subheader("Цели на день")
    st.session_state.goals["calories"] = st.number_input(
        "Калории, ккал", 500, 6000, st.session_state.goals["calories"], 50)
    st.session_state.goals["protein"] = st.number_input(
        "Белки, г", 30, 400, st.session_state.goals["protein"], 5)
    st.session_state.goals["fat"] = st.number_input(
        "Жиры, г", 20, 300, st.session_state.goals["fat"], 5)
    st.session_state.goals["carbs"] = st.number_input(
        "Углеводы, г", 30, 500, st.session_state.goals["carbs"], 5)
    st.session_state.goals["fiber"] = st.number_input(
        "Клетчатка, г", 10, 60, st.session_state.goals["fiber"], 1)

    st.divider()
    st.subheader("Профиль")
    st.checkbox("СПКЯ (синдром поликистозных яичников)", value=True, key="pcos")
    st.checkbox("Инсулинорезистентность (ИР)", value=True, key="ir")
    st.caption("При СПКЯ/ИР рекомендации ориентированы на низкий ГИ (≤55) и белок 25–30%.")

    st.divider()
    if st.button("🧹 Очистить дневник", use_container_width=True):
        st.session_state.meals = []
        st.rerun()

    if st.session_state.meals:
        data = {
            "date": datetime.now().strftime("%Y-%m-%d"),
            "meals": st.session_state.meals,
        }
        st.download_button(
            "💾 Скачать дневник (JSON)",
            data=json.dumps(data, ensure_ascii=False, indent=2),
            file_name=f"kbzhu_{datetime.now().strftime('%Y-%m-%d')}.json",
            mime="application/json",
            use_container_width=True,
        )

# ==================== ЗАГОЛОВОК ====================
st.title("🥗 Калькулятор КБЖУ")
st.caption("Отслеживание калорий, БЖУ и гликемического индекса • Поддержка СПКЯ и ИР")

# ==================== ДОБАВЛЕНИЕ ПРОДУКТА ====================
st.subheader("➕ Добавить продукт")

col1, col2, col3 = st.columns([3, 1, 1])
with col1:
    selected = st.selectbox("Продукт", FOOD_LIST, index=0)
with col2:
    grams = st.number_input("Граммы", min_value=1.0, max_value=2000.0, value=100.0, step=10.0)
with col3:
    st.write("")
    st.write("")
    if st.button("Добавить", type="primary", use_container_width=True):
        cal, p, f, c, gi, cat = FOOD_DB[selected]
        k = grams / 100.0
        st.session_state.meals.append({
            "time": datetime.now().strftime("%H:%M"),
            "product": selected,
            "grams": grams,
            "kcal": round(cal * k, 1),
            "protein": round(p * k, 1),
            "fat": round(f * k, 1),
            "carbs": round(c * k, 1),
            "gi": gi,
            "category": cat,
        })
        st.rerun()

cal, p, f, c, gi, cat = FOOD_DB[selected]
gi_txt = f"ГИ: **{gi}**" if gi > 0 else "ГИ: —"
st.info(
    f"**{selected}** на 100 г → {cal} ккал • Б: {p} г • Ж: {f} г • У: {c} г • {gi_txt} • Категория: {cat}"
)

st.divider()

# ==================== ИТОГИ ====================
meals = st.session_state.meals
total_cal = sum(m["kcal"] for m in meals)
total_prot = sum(m["protein"] for m in meals)
total_fat = sum(m["fat"] for m in meals)
total_carb = sum(m["carbs"] for m in meals)

total_fiber = 0.0
for m in meals:
    if m["category"] in ("Овощи", "Фрукты"):
        total_fiber += m["grams"] * 0.02
    elif m["category"] == "Углеводы":
        total_fiber += m["grams"] * 0.01

goals = st.session_state.goals

st.subheader("📊 Итоги за день")
m1, m2, m3, m4, m5 = st.columns(5)
m1.metric("Калории", f"{total_cal:.0f}", f"{total_cal - goals['calories']:+.0f} ккал", delta_color="inverse")
m2.metric("Белки", f"{total_prot:.0f} г", f"{total_prot - goals['protein']:+.0f} г")
m3.metric("Жиры", f"{total_fat:.0f} г", f"{total_fat - goals['fat']:+.0f} г")
m4.metric("Углеводы", f"{total_carb:.0f} г", f"{total_carb - goals['carbs']:+.0f} г")
m5.metric("Клетчатка", f"{total_fiber:.0f} г", f"{total_fiber - goals['fiber']:+.0f} г")

progress = min(total_cal / goals["calories"], 1.0) if goals["calories"] else 0
st.progress(progress, text=f"Калории: {total_cal:.0f} / {goals['calories']} ккал ({progress*100:.0f}%)")

st.divider()

# ==================== ДНЕВНИК ====================
st.subheader("📋 Дневник питания")

if meals:
    df = pd.DataFrame(meals)
    df_display = df[["time", "product", "grams", "kcal", "protein", "fat", "carbs", "gi"]].rename(columns={
        "time": "Время", "product": "Продукт", "grams": "г",
        "kcal": "Ккал", "protein": "Б", "fat": "Ж", "carbs": "У", "gi": "ГИ"
    })
    st.dataframe(df_display, use_container_width=True, hide_index=True)

    col_del1, col_del2 = st.columns([3, 1])
    with col_del1:
        del_idx = st.selectbox(
            "Удалить позицию:",
            options=range(len(meals)),
            format_func=lambda i: f"{i+1}. {meals[i]['product']} ({meals[i]['grams']:.0f} г, {meals[i]['time']})"
        )
    with col_del2:
        st.write("")
        st.write("")
        if st.button("🗑 Удалить", use_container_width=True):
            del st.session_state.meals[del_idx]
            st.rerun()
else:
    st.info("Дневник пуст. Добавьте первый продукт.")

st.divider()

# ==================== РЕКОМЕНДАЦИИ ====================
st.subheader("💡 Рекомендации (СПКЯ / ИР)")

if not meals:
    st.info("Добавьте продукты, чтобы получить персональные рекомендации.")
else:
    high_gi = [m for m in meals if m["gi"] >= 70]
    medium_gi = [m for m in meals if 56 <= m["gi"] < 70]

    carb_pct = (total_carb * 4) / total_cal * 100 if total_cal else 0
    prot_pct = (total_prot * 4) / total_cal * 100 if total_cal else 0
    fat_pct = (total_fat * 9) / total_cal * 100 if total_cal else 0

    st.markdown("**Соотношение БЖУ по калорийности:**")
    macro_df = pd.DataFrame({
        "Нутриент": ["Белки", "Жиры", "Углеводы"],
        "% от калорий": [round(prot_pct, 1), round(fat_pct, 1), round(carb_pct, 1)],
        "Рекомендуется": ["25–30%", "30–35%", "35–45%"],
    })
    st.dataframe(macro_df, use_container_width=True, hide_index=True)

    if high_gi:
        names = ", ".join(sorted(set(m["product"] for m in high_gi)))
        st.error(f"⚠️ **Высокий ГИ (≥70):** {names}\n\nЗамените на продукты с низким ГИ (≤55).")

    if medium_gi:
        names = ", ".join(sorted(set(m["product"] for m in medium_gi)))
        st.warning(f"🟡 **Средний ГИ (56–69):** {names}\n\nУпотребляйте умеренно, желательно с белком или жиром.")

    if not high_gi and not medium_gi:
        st.success("✅ Все продукты в дневнике имеют низкий ГИ (≤55). Отлично для СПКЯ/ИР!")

    cols = st.columns(3)
    with cols[0]:
        if prot_pct < 25:
            st.warning(f"🥩 Белок {prot_pct:.0f}% — ниже нормы. Добавьте курицу, рыбу, творог, тофу.")
        else:
            st.success(f"✅ Белок {prot_pct:.0f}% — в норме.")
    with cols[1]:
        if carb_pct > 45:
            st.warning(f"🍚 Углеводы {carb_pct:.0f}% — выше нормы. Снизьте долю круп и хлеба.")
        else:
            st.success(f"✅ Углеводы {carb_pct:.0f}% — в норме.")
    with cols[2]:
        if fat_pct < 30:
            st.warning(f"🥑 Жиры {fat_pct:.0f}% — ниже нормы. Добавьте оливковое масло, орехи, авокадо.")
        else:
            st.success(f"✅ Жиры {fat_pct:.0f}% — в норме.")

    with st.expander("📖 Общие советы при СПКЯ и ИР", expanded=False):
        st.markdown("""
        - **Выбирайте продукты с ГИ ≤55:** овощи, бобовые, цельные злаки, ягоды.
        - **Ешьте 5–6 раз в день** небольшими порциями каждые 3–4 часа — это стабилизирует сахар в крови.
        - **Добавьте омега-3:** лосось, сардины, семена чиа, грецкие орехи.
        - **Ограничьте:** сахар, белый хлеб, белый рис, картофель, сладкие напитки, соки.
        - **Комбинируйте углеводы с белком и жиром** — это снижает гликемический ответ.
        - **Клетчатка 25–30 г в день** — овощи, отруби, семена льна, бобовые.
        - **Движение после еды** (10–15 мин ходьбы) помогает снизить уровень глюкозы.
        """)
